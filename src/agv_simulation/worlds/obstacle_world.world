<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="enclosed_arena">
    <!-- 场景设置 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 围栏系统 ==================== -->
    <!-- 围栏参数: 长10米, 宽6米, 高0.5米 -->

    <!-- 前围栏 -->
    <model name="fence_front">
      <static>true</static>
      <pose>0 -3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.2 0.3 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 后围栏 -->
    <model name="fence_back">
      <static>true</static>
      <pose>0 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.2 0.3 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 左围栏 -->
    <model name="fence_left">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.2 0.3 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 右围栏 -->
    <model name="fence_right">
      <static>true</static>
      <pose>5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.2 0.3 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 障碍物 ==================== -->

    <!-- 方块障碍物 (红色) -->
    <model name="box_obstacle">
      <static>true</static>
      <pose>-2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.2 0.2 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 圆柱障碍物 (蓝色) -->
    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>2 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 1 1</ambient>
            <diffuse>0.2 0.5 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 额外的圆柱障碍物 (绿色, 可选) -->
    <model name="cylinder_obstacle_2">
      <static>true</static>
      <pose>1 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 光照 ==================== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ==================== GUI设置 ==================== -->
    <gui>
      <camera name="user_camera">
        <projection_type>perspective</projection_type>
        <pose>0 -8 6 0 0.6 1.57</pose>
        <!-- 初始视角: x=0, y=-8, z=6, 俯仰角0.6rad, 朝向1.57rad(90度) -->
      </camera>
    </gui>

    <!-- ==================== 物理引擎 ==================== -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <gravity>0 0 -9.8</gravity>
    </physics>

  </world>
</sdf>
